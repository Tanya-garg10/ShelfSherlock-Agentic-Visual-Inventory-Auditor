# FEATHERLESS_API_KEY: Required for Featherless AI API calls (featherless.ai).
# Get your key from https://featherless.ai/register
FEATHERLESS_API_KEY="your_featherless_api_key_here"

# FEATHERLESS_MODEL: The model to use from featherless.ai (OpenAI-compatible).
# Default: meta-llama/Llama-3.3-70B-Instruct
FEATHERLESS_MODEL="meta-llama/Llama-3.3-70B-Instruct"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ARTIFACTS_DIR: Directory where audit artifacts (images, overlays, heatmaps) are stored.
# Defaults to /tmp/shelf_artifacts if not set.
ARTIFACTS_DIR="/tmp/shelf_artifacts"

# REVIEW_STORE_FILE: Path to the JSON file used to persist human review decisions.
# Defaults to /tmp/shelf_artifacts/review_store.json if not set.
REVIEW_STORE_FILE="/tmp/shelf_artifacts/review_store.json"
